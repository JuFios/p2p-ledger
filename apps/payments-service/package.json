{
  "name": "payments-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run:prod": "node node_modules/typeorm/cli.js -d dist/data-source.js migration:run",
    "migration:revert:prod": "node node_modules/typeorm/cli.js -d dist/data-source.js migration:revert",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "@opentelemetry/auto-instrumentations-node": "~0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.223.0",
    "@opentelemetry/sdk-node": "~0.223.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^10.0.2",
    "@opentelemetry/api": "~1.9.0",
    "axios": "^1.21.0",
    "ioredis": "^5.11.1",
    "opossum": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "typeorm": "^0.3.20",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^6.3.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(/test/.*|\\.(test|spec))\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/e2e/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "overrides": {
    "multer@2": "^2.5.0",
    "glob@10": "^10.5.0",
    "body-parser@1": "^1.20.9",
    "qs@6": "^6.17.1",
    "lodash@4": "^4.18.1",
    "js-yaml@4": "^4.3.2",
    "webpack@5": "^5.112.2",
    "ajv@8": "^8.18.0",
    "picomatch@4": "^4.0.4",
    "tmp@0.2": "^0.2.6"
  }
}
